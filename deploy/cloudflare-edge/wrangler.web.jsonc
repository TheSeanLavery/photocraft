{
  "name": "photocraft-web",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "build": {
    "command": "worker-build --release"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 50
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PhotoCraftRoom",
        "script_name": "photocraft-mp"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "WEB_ASSETS",
      "bucket_name": "photocraft-web-assets"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMISSION_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
