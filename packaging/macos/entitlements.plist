<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for PhotoCraft. The app is pure Rust,
     loads no unsigned code, needs no JIT, and is not sandboxed (it opens files by path, from the
     command line and drag-and-drop). Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- Optional push-to-talk capture still requires the user to grant microphone access. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
