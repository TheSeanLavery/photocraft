[Desktop Entry]
Type=Application
Name=PhotoCraft
GenericName=Image Editor
Comment=Edit photos and layered PSD documents
Exec=photocraft %U
TryExec=photocraft
Icon=ai.storyteller.photocraft
Terminal=false
# The native runner does not complete desktop startup-notification handshakes.
StartupNotify=false
StartupWMClass=ai.storyteller.photocraft
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;image;editor;psd;photoshop;layers;retouch;paint;
MimeType=x-scheme-handler/photocraft;application/x-photocraft;image/x-paintnet;image/openraster;image/vnd.adobe.photoshop;image/x-psd;image/x-psb;image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-exr;image/vnd.radiance;image/avif;image/qoi;
# AppRun registers desktop integration; avoid duplicate external registration.
X-AppImage-Integrate=false
